<?xml version="1.0" encoding="utf-8"?>
<robot name="fullrobotassem">

  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <origin xyz="-0.046589 -0.236534 0.17626923" rpy="0 0 0"/>
    <parent link="base_footprint"/>
    <child link="base_link"/>
  </joint>

  <link name="base_link">
    <inertial>
      <origin xyz="0.139089 0.236534 0.235731" rpy="0 0 0" />
      <mass value="2.99" />
      <inertia ixx="0.20147" ixy="0" ixz="0" iyy="0.203289" iyz="0" izz="0.0664029" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://fullrobotassem/meshes/base_link.STL" />
      </geometry>
      <material name="gray_base">
        <color rgba="0.5 0.5 0.5 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://fullrobotassem/meshes/base_link.STL" />
      </geometry>
    </collision>
  </link>

  <link name="lidar_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.1" />
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.001" length="0.001"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.05" length="0.04"/>
      </geometry>
    </collision>
  </link>

  <joint name="lidar_joint" type="fixed">
    <origin xyz="0.19 0.235 -0.02" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="lidar_link" />
  </joint>

  <link name="upper_body">
    <inertial>
      <origin xyz="0.286589 0.236535 0.485083" rpy="0 0 0" />
      <mass value="1.0125" />
      <inertia ixx="0.0136493" ixy="0" ixz="0" iyy="0.00485359" iyz="0" izz="0.0104832" />
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://fullrobotassem/meshes/upper_body.STL" />
      </geometry>
      <material name="white_body">
        <color rgba="1 1 1 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://fullrobotassem/meshes/upper_body.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="upperbody" type="prismatic">
    <origin xyz="0 0 0" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="upper_body" />
    <axis xyz="0 0 1" />
    <limit lower="-0.30" upper="0.065" effort="100" velocity="0.1" />
    <dynamics damping="5.0" friction="1.0" />
  </joint>

  <link name="left_shoulder">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.42814" />
      <inertia ixx="0.000424904" ixy="-2.0093e-06" ixz="1.14749e-06" iyy="0.000411979" iyz="2.78952e-05" izz="0.000418193" />
    </inertial>
    <visual>
      <origin xyz="-0.287084 -0.444446 -0.493527" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://fullrobotassem/meshes/left_shoulder.STL" />
      </geometry>
      <material name="white_left_shoulder">
        <color rgba="1 1 1 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="-0.287084 -0.444446 -0.493527" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://fullrobotassem/meshes/left_shoulder.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="left_shoulder_joint" type="revolute">
    <origin xyz="0.287084 0.444446 0.493527" rpy="0 0 0" />
    <parent link="upper_body" />
    <child link="left_shoulder" />
    <axis xyz="0 1 0" />
    <limit lower="-3.14" upper="1.57" effort="5" velocity="2.0" />
    <dynamics damping="0.1" friction="0.05" />
  </joint>

  <link name="left_arm">
    <inertial>
      <origin xyz="0.039221 0.009252 -0.127083" rpy="0 0 0" />
      <mass value="0.44382" />
      <inertia ixx="0.00100882" ixy="-0.000152956" ixz="0.000891016" iyy="0.00237659" iyz="0.000157432" izz="0.00157024" />
    </inertial>
    <visual>
      <origin xyz="-0.299505 -0.462575 -0.493527" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://fullrobotassem/meshes/left_arm.STL" />
      </geometry>
      <material name="white_left_arm">
        <color rgba="1 1 1 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="-0.299505 -0.462575 -0.493527" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://fullrobotassem/meshes/left_arm.STL" />
      </geometry>
    </collision>
  </link>
  <joint name="left_arm_joint" type="revolute">
    <!-- <origin xyz="0 0 0" rpy="0 0 0" /> -->
    <origin xyz="0.012421 0.018129 0" rpy="0 0 0" />
    <parent link="left_shoulder" />
    <child link="left_arm" />
    <axis xyz="0 0 1" />
    <limit lower="-1.57" upper="1.57" effort="5" velocity="2.0" />
    <dynamics damping="0.1" friction="0.05" />
  </joint>

  <link name="right_shoulder">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.42793" />
      <inertia ixx="0.000423755" ixy="6.96857e-06" ixz="2.06603e-06" iyy="0.000411368" iyz="-2.68761e-05" izz="0.000418739" />
    </inertial>
    <visual>
      <origin xyz="-0.286956 -0.028614 -0.493711" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://fullrobotassem/meshes/right_shoulder.STL" />
      </geometry>
      <material name="white_right_shoulder">
        <color rgba="1 1 1 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="-0.286956 -0.028614 -0.493711" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://fullrobotassem/meshes/right_shoulder.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="right_shoulder_joint" type="revolute">
    <origin xyz="0.286956 0.028614 0.493711" rpy="0 0.24 0" />
    <parent link="upper_body" />
    <child link="right_shoulder" />
    <axis xyz="0 1 0" />
    <limit lower="-3.38" upper="1.33" effort="5" velocity="2.0" />
    <dynamics damping="0.1" friction="0.05" />
  </joint>

  <link name="right_arm">
    <inertial>
      <origin xyz="0.063229 -0.002284 -0.116748" rpy="0 0 0" />
      <mass value="0.44382" />
      <inertia ixx="0.000649348" ixy="-0.000124844" ixz="0.00068582" iyy="0.00235011" iyz="-9.51443e-06" izz="0.00189447" />
    </inertial>
    <visual>
      <origin xyz="-0.299145 -0.010485 -0.496694" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://fullrobotassem/meshes/right_arm.STL" />
      </geometry>
      <material name="white_right_arm">
        <color rgba="1 1 1 1" />
      </material>
    </visual> 
    <collision>
      <origin xyz="-0.299145 -0.010485 -0.496694" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://fullrobotassem/meshes/right_arm.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="right_arm_joint" type="revolute">
    <origin xyz="0.012189 -0.018129 0.002983" rpy="0 0 0" />
    <parent link="right_shoulder" />
    <child link="right_arm" />
    <axis xyz="-0.237703 0 0.971338" />
    <limit lower="-1.57" upper="1.57" effort="5" velocity="2.0" />
    <dynamics damping="0.1" friction="0.05" />
  </joint>

<link name="right_wheel">
  <inertial>
    <origin xyz="0 0 0" rpy="0 0 0" />
    <mass value="0.05056" />
    <inertia ixx="1.4651E-05" ixy="0" ixz="0" iyy="2.5069E-05" iyz="0" izz="1.4653E-05" />
  </inertial>
  <visual>
    <origin xyz="-0.046589 -0.057034 0.149269" rpy="0 0 0" />
    <geometry>
      <mesh filename="package://fullrobotassem/meshes/right_wheel.STL" />
    </geometry>
    <material name="">
      <color rgba="1 1 1 1" />
    </material>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="1.5708 0 0" />
    <geometry>
      <cylinder radius="0.03" length="0.026" />
    </geometry>
  </collision>
</link>

<joint name="rightwheel" type="continuous">
  <origin xyz="0.046589 0.057034 -0.149269" rpy="0 0 0" />
  <parent link="base_link" />
  <child link="right_wheel" />
  <axis xyz="0 1 0" />
  <limit effort="5" velocity="11.52" />
</joint>

<link name="left_wheel">
  <inertial>
    <origin xyz="0 0 0" rpy="0 0 0" />
    <mass value="0.05056" />
    <inertia ixx="1.4651E-05" ixy="0" ixz="0" iyy="2.5069E-05" iyz="0" izz="1.4653E-05" />
  </inertial>
  <visual>
    <origin xyz="-0.046589 -0.416034 0.149269" rpy="0 0 0" />
    <geometry>
      <mesh filename="package://fullrobotassem/meshes/left_wheel.STL" />
    </geometry>
    <material name="">
      <color rgba="1 1 1 1" />
    </material>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="1.5708 0 0" />
    <geometry>
      <cylinder radius="0.03" length="0.026" />
    </geometry>
  </collision>
</link>

<joint name="leftwheel" type="continuous">
  <origin xyz="0.046589 0.416034 -0.149269" rpy="0 0 0" />
  <parent link="base_link" />
  <child link="left_wheel" />
  <axis xyz="0 1 0" />
  <limit effort="5" velocity="11.52" />
</joint>

  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>40</update_rate>
      <topic>/scan</topic>
      <gz_frame_id>lidar_link</gz_frame_id>
      <ray>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.30</min>
          <max>30.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
    </sensor>
  </gazebo>

  <link name="caster_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.02"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.02"/></geometry>
    </collision>
  </link> 

  <joint name="caster_joint" type="fixed">
    <origin xyz="0.30 0.2365 -0.159269" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="caster_link"/>
  </joint>

  <gazebo reference="caster_link">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
  </gazebo>

  <gazebo reference="left_wheel">
    <mu1>1.5</mu1>
    <mu2>1.5</mu2>
    <minDepth>0.001</minDepth>
    <visual>
      <material>
        <ambient>0.05 0.05 0.05 1</ambient>
        <diffuse>0.05 0.05 0.05 1</diffuse>
        <specular>0.1 0.1 0.1 1</specular>
      </material>
    </visual>
  </gazebo>

  <gazebo reference="right_wheel">
    <mu1>1.5</mu1>
    <mu2>1.5</mu2>
    <minDepth>0.001</minDepth>
    <visual>
      <material>
        <ambient>0.05 0.05 0.05 1</ambient>
        <diffuse>0.05 0.05 0.05 1</diffuse>
        <specular>0.1 0.1 0.1 1</specular>
      </material>
    </visual>
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>leftwheel</left_joint>
      <right_joint>rightwheel</right_joint>
      <wheel_separation>0.359</wheel_separation>
      <wheel_radius>0.03</wheel_radius>
      <max_linear_velocity>0.27</max_linear_velocity>
      <min_linear_velocity>-0.27</min_linear_velocity>
      <max_angular_velocity>1.5</max_angular_velocity>
      <min_angular_velocity>-1.5</min_angular_velocity>
      <max_linear_acceleration>0.5</max_linear_acceleration>
      <min_linear_acceleration>-0.5</min_linear_acceleration>
      <max_angular_acceleration>2.0</max_angular_acceleration>
      <min_angular_acceleration>-2.0</min_angular_acceleration>
      <odom_publish_frequency>50</odom_publish_frequency>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
    </plugin>
  </gazebo>
  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
    </plugin>
  </gazebo>

  <!-- 1. CAMERA LINK -->
  <link name="camera_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.08 0.03"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.08 0.03"/>
      </geometry>
    </collision>
  </link>

  <link name="camera_link_optical"/>

  <joint name="camera_joint" type="fixed">
    <origin xyz="0.35 0.2365 0.52" rpy="0 0.349066 0"/>
    <parent link="upper_body"/>
    <child link="camera_link"/>
  </joint>

  <joint name="camera_optical_joint" type="fixed">
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
    <parent link="camera_link"/>
    <child link="camera_link_optical"/>
  </joint>

  <gazebo reference="camera_link">
    <sensor name="camera" type="camera">
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <topic>/camera/image_raw</topic>
      <gz_frame_id>camera_link_optical</gz_frame_id>
      <camera>
        <horizontal_fov>1.089</horizontal_fov> 
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>8.0</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>
  <gazebo>
    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>upperbody</joint_name>
      <topic>/upper_body/cmd_pos</topic>
      <p_gain>2000</p_gain>
      <i_gain>100</i_gain>
      <d_gain>150</d_gain>
      <i_max>50</i_max>
      <i_min>-50</i_min>
      <cmd_max>100</cmd_max>
      <cmd_min>-100</cmd_min>
    </plugin>
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>left_arm_joint</joint_name>
      <topic>/left_arm/cmd_pos</topic>
      <p_gain>20</p_gain>
      <i_gain>0.5</i_gain>
      <d_gain>2</d_gain>
      <i_max>2</i_max>
      <i_min>-2</i_min>
      <cmd_max>5</cmd_max>
      <cmd_min>-5</cmd_min>
    </plugin>
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>right_arm_joint</joint_name>
      <topic>/right_arm/cmd_pos</topic>
      <p_gain>20</p_gain>
      <i_gain>0.5</i_gain>
      <d_gain>2</d_gain>
      <i_max>2</i_max>
      <i_min>-2</i_min>
      <cmd_max>5</cmd_max>
      <cmd_min>-5</cmd_min>
    </plugin>
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>left_shoulder_joint</joint_name>
      <topic>/left_shoulder/cmd_pos</topic>
      <p_gain>20</p_gain>
      <i_gain>0.5</i_gain>
      <d_gain>2</d_gain>
      <i_max>2</i_max>
      <i_min>-2</i_min>
      <cmd_max>5</cmd_max>
      <cmd_min>-5</cmd_min>
    </plugin>
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>right_shoulder_joint</joint_name>
      <topic>/right_shoulder/cmd_pos</topic>
      <p_gain>20</p_gain>
      <i_gain>0.5</i_gain>
      <d_gain>2</d_gain>
      <i_max>2</i_max>
      <i_min>-2</i_min>
      <cmd_max>5</cmd_max>
      <cmd_min>-5</cmd_min>
    </plugin>
  </gazebo>
  
</robot>