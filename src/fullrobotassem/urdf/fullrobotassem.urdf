<?xml version="1.0" encoding="utf-8"?>
<robot name="fullrobotassem">

  <link name="base_footprint"/>

  <link name="dummy_link"/>

  <joint name="dummy_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 1.5708" /> 
    <parent link="base_footprint"/>
    <child link="dummy_link"/>
  </joint>

  <joint name="base_joint" type="fixed">
    <origin xyz="0 0 0.17" rpy="0 0 0" />
    <parent link="dummy_link"/>
    <child link="base_link"/>
  </joint>

  <link name="base_link">
    <inertial>
      <origin xyz="0.18 0.23 -0.1" rpy="0 0 0" />
      <mass value="15.0" />
      <inertia ixx="0.5" ixy="0.0" ixz="0.0" iyy="0.5" iyz="0.0" izz="0.5" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://fullrobotassem/meshes/base_link.STL" />
      </geometry>
      <!-- base_link: Màu xám -->
      <material name="gray_base">
        <color rgba="0.5 0.5 0.5 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://fullrobotassem/meshes/base_link.STL" />
      </geometry>
    </collision>
  </link>

  <link name="lidar_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.1" />
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.001" length="0.001"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.05" length="0.04"/>
      </geometry>
    </collision>
  </link>

  <joint name="lidar_joint" type="fixed">
    <origin xyz="0.19 0.235 -0.02" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="lidar_link" />
  </joint>

  <link name="upper_body">
    <inertial>
      <origin xyz="0.51167 0.082198 0.24248" rpy="0 0 0" />
      <mass value="1.0125" />
      <inertia ixx="0.015585" ixy="1.1113E-11" ixz="0.00045297" iyy="0.0033239" iyz="-8.855E-10" izz="0.014182" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://fullrobotassem/meshes/upper_body.STL" />
      </geometry>
      <!-- upper_body: Màu trắng -->
      <material name="white_body">
        <color rgba="1 1 1 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://fullrobotassem/meshes/upper_body.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="upperbody" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="upper_body" />
  </joint>

  <link name="left_shoulder">
    <inertial>
      <origin xyz="0.0018239 -0.37459 0.0034287" rpy="0 0 0" />
      <mass value="0.42814" />
      <inertia ixx="0.00038187" ixy="6.5097E-07" ixz="1.9282E-06" iyy="0.00038114" iyz="7.843E-06" izz="0.00040597" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://fullrobotassem/meshes/left_shoulder.STL" />
      </geometry>
      <!-- left_shoulder: Màu trắng -->
      <material name="white_left_shoulder">
        <color rgba="1 1 1 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://fullrobotassem/meshes/left_shoulder.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="leftshoulder" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="left_shoulder" />
  </joint>

  <link name="left_arm">
    <inertial>
      <origin xyz="-0.023473 0.40429 0.13464" rpy="0 0 0" />
      <mass value="0.44382" />
      <inertia ixx="0.00047293" ixy="-1.237E-05" ixz="0.00030713" iyy="0.0010343" iyz="5.6973E-07" izz="0.00068766" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://fullrobotassem/meshes/left_arm.STL" />
      </geometry>
      <!-- left_arm: Màu trắng -->
      <material name="white_left_arm">
        <color rgba="1 1 1 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://fullrobotassem/meshes/left_arm.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="leftarm" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="left_arm" />
  </joint>

  <link name="right_shoulder">
    <inertial>
      <origin xyz="-0.00070418 -0.36759 -0.002038" rpy="0 0 0" />
      <mass value="0.42793" />
      <inertia ixx="0.00038339" ixy="2.042E-06" ixz="-6.1722E-06" iyy="0.00038114" iyz="-7.5994E-06" izz="0.00040445" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://fullrobotassem/meshes/right_shoulder.STL" />
      </geometry>
      <!-- right_shoulder: Màu trắng -->
      <material name="white_right_shoulder">
        <color rgba="1 1 1 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://fullrobotassem/meshes/right_shoulder.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="rightshoulder" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="right_shoulder" />
  </joint>

  <link name="right_arm">
    <inertial>
      <origin xyz="-0.059013 -0.45576 0.071366" rpy="0 0 0" />
      <mass value="0.44382" />
      <inertia ixx="0.00031781" ixy="0.00015273" ixz="0.00013066" iyy="0.0010012" iyz="-1.6114E-05" izz="0.00087585" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://fullrobotassem/meshes/right_arm.STL" />
      </geometry>
      <!-- right_arm: Màu trắng -->
      <material name="white_right_arm">
        <color rgba="1 1 1 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://fullrobotassem/meshes/right_arm.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="right_arm_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="right_arm" />
  </joint>

  <link name="right_wheel">
    <inertial>
      <origin xyz="-0.0023445 0.35936 0.0008921" rpy="0 0 0" />
      <mass value="0.05056" />
      <inertia ixx="1.4651E-05" ixy="-4.8342E-09" ixz="4.7127E-10" iyy="2.5069E-05" iyz="-2.331E-08" izz="1.4653E-05" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://fullrobotassem/meshes/right_wheel.STL" />
      </geometry>
      <material name="">
        <color rgba="0 0 0 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://fullrobotassem/meshes/right_wheel.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="rightwheel" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="right_wheel" />
  </joint>

  <link name="left_wheel">
    <inertial>
      <origin xyz="0.002619 0.35924 -0.00016613" rpy="0 0 0" />
      <mass value="0.05056" />
      <inertia ixx="1.4651E-05" ixy="-2.0514E-09" ixz="-2.0348E-10" iyy="2.5069E-05" iyz="2.3717E-08" izz="1.4653E-05" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://fullrobotassem/meshes/left_wheel.STL" />
      </geometry>
      <material name="">
        <color rgba="0 0 0 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://fullrobotassem/meshes/left_wheel.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="leftwheel" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="left_wheel" />
  </joint>


  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>40</update_rate>
      <topic>/scan</topic>
      <gz_frame_id>lidar_link</gz_frame_id>
      <ray>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.10</min>
          <max>30.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
    </sensor>
  </gazebo>

  <gazebo reference="left_wheel">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
  </gazebo>

  <gazebo reference="right_wheel">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
  </gazebo>
</robot>